// OpenSCAD: screwdriver button blocker — блокировщик кнопок отвёртки
// Версия: v1.0 — initial

description = "Cylindrical tube that fits over screwdriver to block button presses";
version_str = "1.0";

// ===== Комментарии ===========================
/*
Модель: цилиндрическая втулка для блокировки кнопок отвёртки
Блоки:
- Переменные (вверху) для всех размеров
- Комментарии (этот блок)
- Функции фрагментов детали (ниже)
- Функция вывода всех фрагментов show_all()
- Функция обрезки через intersection при test_fragment=true

Детали: base (основная деталь - полый цилиндр)
Фрагменты:
- base — полый цилиндр с внутренним диаметром 23.8 мм, длиной 40 мм, толщиной стенки 1.2 мм
- notch — прямоугольный вырез в стенке цилиндра (difference): длина 34 мм, ширина 7 мм, глубина 0.5 мм

План: 
- Создать полый цилиндр через difference внешнего и внутреннего цилиндров
- Вырезать паз (notch) в стенке цилиндра для доступа к кнопкам
- Ориентация: цилиндр стоит вертикально, ось Z вверх
*/

use <../modules.scad>;

// ===== Точность аппроксимации окружностей =====
$fn = 0;        // фиксированную сегментацию отключаем
$fa = 6;        // 5–8° обычно достаточно
$fs = 0.35;     // ≈ диаметр сопла (0.3–0.5 для сопла 0.4)
pin_fs = 0.25;  // чуть тоньше для штырей и отверстий

// ===== Режим печати тест‑фрагментов =====
test_fragment = false;   // true — печатать только угловые фрагменты
frag_size     = 20;      // размер квадрата вырезки, мм
frag_index    = 0;       // 0=НЛ, 1=ВЛ, 2=НП, 3=ВП (относительно основания)
frag_gap_x    = 10;      // зазор между фрагментами по X, мм
frag_h_extra  = 20;      // запас по высоте клипа, мм

// ===== Общие доп. параметры =====
tiny = 0.1;                  // небольшой зазор для булевых операций
edge_chamfer_z = 1;       // высота фаски по Z (мм)
edge_chamfer_x = 5;       // горизонтальный вылет фаски по X (с каждой стороны), мм
edge_chamfer_y = 5;       // горизонтальный вылет фаски по Y (с каждой стороны), мм
screen_frame_gap = 0.2;      // только для высоты вычитаний в рамке (не влияет на XY)

// ===== Параметры модели =====
// Основные размеры цилиндра
inner_diameter = 24.15;    // внутренний диаметр цилиндра, мм
length = 40;               // длина цилиндра, мм
wall_thickness = 1.6;      // толщина стенки, мм

// Параметры паза (notch)
notch_length = 40;         // длина паза по оси цилиндра, мм
notch_width = 8;           // ширина паза по окружности, мм
notch_depth = 1.0;         // глубина паза в стенку, мм
notch_offset = 0;          // смещение паза от начала цилиндра, мм
notch_inner_offset = 0.8;  // смещение паза внутрь от внешней поверхности, мм

// ===== Вычисляемые размеры =====
inner_radius = inner_diameter / 2;
outer_diameter = inner_diameter + 2 * wall_thickness;
outer_radius = outer_diameter / 2;

// Для клиппера фрагментов
base_h = length;

// ===== Вспомогательные функции ====================
function clamp(val, lo, hi) = max(lo, min(val, hi));
function clamp_chz(t, chz) = clamp(chz, 0, t/2);

// ===== Модули деталей ====================
// Основная деталь: полый цилиндр с пазом
module base() {
  difference() {
    // Внешний цилиндр
    cylinder(h=length, d=outer_diameter, $fs=pin_fs, $fa=6);
    
    // Внутренний цилиндр (вырез)
    translate([0, 0, -tiny])
      cylinder(h=length + 2*tiny, d=inner_diameter, $fs=pin_fs, $fa=6);
    
    // Паз (notch) в стенке цилиндра
    // Позиционируем паз: смещение от начала цилиндра, вырез в радиальном направлении
    translate([0, 0, (length-notch_length)/2 + notch_length/2]) {
      // Вырезаем прямоугольный паз
      // Позиционируем так, чтобы паз начинался от внешнего радиуса минус смещение внутрь и углублялся на notch_depth
      translate([outer_radius - notch_inner_offset - notch_depth, 0, 0]) {
        // Создаём куб для выреза паза
        // Размеры: глубина (радиально), ширина (по окружности), длина (по оси)
        cube([notch_depth + tiny, notch_width, notch_length], center=true);
      }
    }
  }
}

// ===== Вывод всех фрагментов ====================
module show_all() {
  if (test_fragment) {
    // Режим тест-фрагментов: обрезка через intersection
    intersection() {
      base();
      // Вырезка углового фрагмента
      // Для цилиндра используем куб, который вырезает часть цилиндра
      // Позиционируем куб так, чтобы он захватывал часть цилиндра с пазом
      translate([-outer_radius, -outer_radius, -frag_h_extra]) {
        cube([frag_size, frag_size, length + 2*frag_h_extra], center=false);
      }
    }
  } else {
    // Полный рендер
    base();
  }
}

// ===== Точка входа ====================
show_all();
