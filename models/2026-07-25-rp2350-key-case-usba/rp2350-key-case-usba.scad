// 3D: RP2350 key case USB-A
// OpenSCAD: RP2350 key — вариант с рамкой USB-A на язычке платы
// Версия: v1.0 — копия rp2350-key-case + рамка USB-A:
//                накладка 0.4 мм добирает язычок платы 1.6 → 2.0 мм,
//                высота выведена из стопки платы (не задаётся вручную)

use <../modules.scad>;

description = "RP2350 USB key case with USB-A shim frame: 0.4 mm shim brings the 1.6 mm PCB tongue to the 2.0 mm the port expects";
version_str = "1.0";

// ===== Точность аппроксимации окружностей =====
$fn = 0;        // фиксированную сегментацию отключаем
$fa = 6;        // 5–8° обычно достаточно
$fs = 0.35;     // ≈ диаметр сопла (0.3–0.5 для сопла 0.4)
pin_fs = 0.25;  // чуть тоньше для штырей и отверстий

// ===== Режим печати тест‑фрагментов =====
test_fragment = false;   // true — печатать только угловые фрагменты
frag_size     = 20;      // размер квадрата вырезки, мм
frag_index    = 0;       // 0=НЛ, 1=ВЛ, 2=НП, 3=ВП (относительно основания)
frag_gap_x    = 10;      // зазор между фрагментами по X, мм
frag_h_extra  = 20;      // запас по высоте клипа, мм

// ===== Общие доп. параметры =====
tiny = 0.1;              // небольшой зазор для булевых операций
edge_chamfer_z = 1;      // высота фаски по Z (мм)
edge_chamfer_x = 5;      // горизонтальный вылет фаски по X, мм
edge_chamfer_y = 5;      // горизонтальный вылет фаски по Y, мм
screen_frame_gap = 0.2;  // только для высоты вычитаний

// ===== Параметры модели =====
// --- Полость под плату (задаёт габариты; менять только вместе с платой) ---
cav_w        = 18.2;     // ширина полости под плату, мм
cav_l        = 25.65;    // длина полости под плату, мм
wall         = 1.0;      // толщина боковых и задней стенок, мм (в оригинале 1.5)
front_wall   = 0.7;      // толщина передней стенки (со стороны USB), мм
floor_th     = 0.8;      // толщина дна (панели с кнопками), мм (в оригинале 2.0)
edge_r       = 1.2;      // радиус скругления всех наружных рёбер, мм
// Высота корпуса здесь не задаётся вручную, а выводится из стопки платы —
// см. case_h в «Вычисляемых размерах».

// --- Полка под плату ---
niche_h      = 1.4;      // высота ниши под платой (под навесные детали снизу), мм
                         // 1.8 → 1.4: плата села ниже на 0.4, эти 0.4 ушли в pcb_top_gap
shelf_in_hw  = 7.1;      // полуширина ниши под платой, мм
shelf_l      = 15.7;     // длина полки от переднего торца, мм

// --- Плата ---
pcb_th       = 1.6;      // толщина платы, мм
pcb_top_gap  = 0.675;    // зазор над платой до низа крышки, мм.
                         // Единственный свободный параметр высоты корпуса:
                         // case_h = pcb_top + pcb_top_gap + lid_h.
                         // 0.075 → 0.675 по результатам печати: крышка не садилась
                         // до конца и выступала на 0.6 мм — ей упиралось снизу
                         // (допуски печати, посадка платы). Зазор и высота корпуса
                         // выросли на эти 0.6 вместе

// --- Рамка USB-A на язычке платы ---
// Порт рассчитан на «штекер» 12.0 x 2.0 мм при глубине вставки 12 мм.
// Плата 1.6 мм болтается по высоте — накладка сверху добирает недостающее.
usba_w       = 11.9;     // ширина язычка платы (= ширина рамки), мм
usba_total_h = 2.0;      // требуемая толщина штекера: плата + накладка, мм
usba_len     = 11.4;     // вылет накладки за передний торец, мм (было 12.0)
usba_slot_gap = 0.15;    // зазор паза в передней стенке по ширине на сторону, мм
usb_slot_dh  = 0.15;     // добавка к высоте паза под язычок платы, мм.
                         // Растёт только вниз: сверху паз упирается в корень
                         // накладки, а снизу под ним ниша, а не полка
usba_ch      = 0.2;      // фаска на входной кромке накладки, мм
// Усиление корня накладки. По результатам печати накладка 0.4 мм оказалась
// слишком мягкой — язычок болтался. Вместо галтели у корня теперь утолщение
// полной толщины на первых usba_root_len мм, а дальше вогнутый переход
// к номинальной толщине накладки.
usba_root_th  = 1.0;     // толщина накладки у передней стенки, мм (номинал 0.4)
usba_root_len = 0.5;     // длина участка полной толщины от стенки, мм
usba_root_dy  = 0.2;     // заход усиления внутрь корпуса (+Y), мм: иначе его верх
                         // выходит перед скруглённым передним ребром лезвием

// --- Пазы под защёлки крышки ---
groove_d     = 0.35;     // глубина паза в стенке, мм (оригинал 0.7 при стенке 1.5)
groove_hh    = 0.45;     // полувысота паза, мм (оригинал 0.6).
                         // Положение паза по Z не задаётся: groove_dz выводится
                         // из положения защёлки на крышке — см. «Вычисляемые размеры»
groove_y1    = [1.82, 8.58];    // передний боковой паз: диапазон по Y, мм
groove_y2    = [18.47, 25.23];  // задний боковой паз: диапазон по Y, мм
groove_back_hw = 3.29;   // полуширина заднего паза (под задний язычок крышки), мм

// --- Диагональные насечки-канавки на боковых стенках (врезаны внутрь) ---
notch_n      = 9;        // число насечек на каждой стороне
notch_pitch  = 2.3025;   // шаг насечек по Y, мм
notch_y0     = 4.94;     // Y центра первой насечки на середине её высоты, мм
notch_edge_gap = 0.3;    // отступ насечек от скруглений низа и верха стенки, мм
notch_depth  = 0.3;      // глубина канавки в стенке, мм
notch_bot_w  = 0.4;      // ширина дна канавки, мм
notch_open_w = 1.0;      // ширина канавки на поверхности стенки, мм
notch_slope  = 0.5733;   // наклон: смещение по -Y на 1 мм высоты

// --- Пружинящие кнопки в дне (B = BOOTSEL, R = RESET) ---
slot_w       = 0.3;      // ширина П-образной прорези, мм
tongue_hw    = 2.625;    // полуширина язычка, мм
tongue_cx    = 6.175;    // смещение центра язычка от оси корпуса, мм
// Прорезь прямоугольная (в оригинале конец был полукруглой аркой) и вдвое
// короче: свободный конец остался на месте — под ним кнопка платы, — а заделка
// подтянулась к нему. Короткий язычок жёстче, ход меньше, нажатие чётче.
tongue_end   = 26.033;   // Y свободного конца язычка, мм
tongue_len   = 5.17;     // длина язычка от заделки до конца, мм (в оригинале 10.333)
// Шарнирные карманы (утончение дна до 1.0 у заделки язычков) убраны:
// при дне 0.8 мм язычок гнётся и без них.

// --- Прочие элементы дна ---
// Карман под гнездо (тонкая мембрана 0.8 сзади по центру) убран — гнездо выпаяно.
hole_d       = 1.0;      // диаметр отверстия в дне под деталь платы, мм
hole_cx      = 0.6;      // смещение центра отверстия от оси симметрии, мм
                         // 2.1 → 0.6: отверстие сдвинуто на 1.5 мм к центру
hole_cy      = 5.35;     // координата центра отверстия по Y, мм
labels_on    = false;    // true — гравировать буквы B/R на кнопках
label_size   = 5.41;     // кегль букв B/R, мм
label_depth  = 0.2;      // глубина гравировки букв, мм
label_flip   = true;     // true — буквы развёрнуты на 180° (взгляд с другой стороны)
// Буквы центруются по язычку кнопки (tongue_cx / tongue_cy). Поправки компенсируют
// метрику шрифта: у text() valign/halign="center" центрирует по боксу шрифта,
// а не по видимому контуру глифа, и у B и R он разный.
label_b_off  = [-0.145, 0.067];  // доводка буквы B [X, Y], мм
label_r_off  = [-0.205, 0.067];  // доводка буквы R [X, Y], мм
label_font   = "Liberation Sans:style=Bold";

// --- Крышка ---
lid_plate_th = 0.8;      // толщина пластины крышки, мм
lid_rim_h    = 0.7;      // высота бортика крышки, мм
lid_gap      = 0.12;     // зазор крышки в полости на сторону, мм
lid_rim_top_x = 11.576;  // проём бортика вверху по X (у пластины), мм
lid_rim_top_y = 19.142;  // проём бортика вверху по Y, мм
lid_rim_bot_x = 14.0;    // проём бортика внизу по X (шире — заходная фаска), мм
lid_rim_bot_y = 21.552;  // проём бортика внизу по Y, мм
lid_rim_r    = 2.65;     // радиус скругления проёма бортика, мм
lid_tab_out  = 0.33;     // выступ боковой защёлки, мм (оригинал 0.487)
lid_tab_len  = 6.46;     // длина боковой защёлки, мм
lid_tab_cy   = 8.275;    // Y центра боковых защёлок от центра пластины, мм
// Защёлка опущена к низу крышки (в оригинале её центр был на 0.975 от низа,
// то есть у самого верха). За ней вниз уходит и паз в стенке корпуса: там он
// попадает в стенку полной толщины, а не в зону скругления верхнего ребра.
lid_tab_c    = 0.4;      // центр боковой защёлки от низа крышки, мм
lid_tab_h    = 0.5;      // высота боковой защёлки, мм (оригинал 0.65)
lid_ftab_hw  = 6.0;      // полуширина переднего язычка, мм
lid_ftab_len = 0;        // 0 — переднего язычка нет: над пазом платы стенка сплошная
lid_rtab_hw  = 3.04;     // полуширина заднего язычка, мм
lid_rtab_len = 0.5;      // вылет заднего язычка, мм
lid_rtab_th  = 0.59;     // толщина заднего язычка, мм

// --- Раскладка на столе ---
print_case   = true;     // печатать корпус
print_lid    = true;     // печатать крышку
lid_flip     = true;     // true — крышка лежит пластиной вниз (без поддержек);
                         // false — бортиком вниз, как она стоит в сборке
part_gap_x   = 5;        // зазор между деталями по X, мм

// ===== Ожидаемая геометрия =====
expected_dims = [43.82, 38.75, 5.98]; // габариты раскладки [X, Y, Z], мм
expected_parts = 2;                   // корпус + крышка
expected_tol = 0.5;                   // допуск сверки, мм

// ===== Комментарии ===========================
/*
Модель: корпус и крышка USB-брелка на плате RP2350.
Восстановлена по мешам RP2350-Case.3mf и rp2350-lid.3mf (FreeCAD/Bambu);
параметрического дерева в 3MF нет — все размеры сняты обмером сеток
(лучевое зондирование + срезы), поэтому воспроизводится форма, не триангуляция.

Оси: X — ширина, Y — длина (Y=0 — торец с USB-C), Z=0 — стол.
Начало координат корпуса — в минимальном углу габарита.

Отличия от оригинала (по заданию):
- дно 2.0 → 0.8 мм: карман под выпаянное гнездо (мембрана 0.8 сзади по центру)
  больше не нужен, а дно 2.0 было толстым именно ради него (карман 1.2 + остаток 0.8);
- высота 8.0 → 5.3 мм: полка опустилась вместе с дном до z=2.6, просвет для платы
  над дном ниши сохранён 3.2 мм;
- шарнирные карманы язычков убраны — дно 0.8 гнётся и без них;
- стенки 1.5 → 1.0 мм, полость под плату не изменилась, корпус ужался снаружи;
- глубина паза под защёлку 0.7 → 0.35 мм и выступ защёлки 0.487 → 0.33 мм:
  при стенке 1.0 мм паз 0.7 оставил бы 0.19 мм стенки у верхней кромки.

Фрагменты корпуса:
- case_body      — наружный объём со скруглением всех рёбер r=1.2
- case_cavity    — полость под плату: широкая часть над полкой + ниша под платой
- usb_slot       — паз в передней стенке под сечение язычка платы
- usba_frame     — накладка рамки USB-A поверх язычка
- usba_root_boss — утолщение корня накладки у передней стенки
- lid_grooves    — пазы под защёлки крышки в боковых стенках и в задней
- side_notches   — диагональные насечки-канавки (хват), врезаны в боковые стенки
- button_slots   — П-образные прорези, образующие пружинящие язычки-кнопки
- floor_hole     — сквозное отверстие ⌀1 в дне под деталь платы
- bottom_labels  — гравировка B (BOOTSEL) и R (RESET), читается снизу

Фрагменты крышки:
- lid_plate      — пластина 0.8 мм с передним и задним язычками
- lid_rim        — периметральный бортик с заходной фаской
- lid_side_tabs  — боковые защёлки, входящие в пазы корпуса
*/

// ===== Вычисляемые размеры =====
// крышка (нужна раньше корпуса: высота корпуса выводится из неё)
lid_w    = cav_w - 2 * lid_gap;           // 17.96
lid_l    = cav_l - 2 * lid_gap;           // 25.41
lid_h    = lid_rim_h + lid_plate_th;      // 1.5

shelf_z    = floor_th + niche_h;          // верх полки под плату = 2.2
pcb_top    = shelf_z + pcb_th;            // верх платы = 3.8
// Крышка целиком тонет в полости и опирается только на защёлки, поэтому её
// положение по Z задаёт паз. Стопка снизу вверх: дно, ниша, плата, зазор,
// крышка — и верх крышки совпадает с верхом корпуса.
lid_bottom = pcb_top + pcb_top_gap;       // низ крышки = 3.875
case_h     = lid_bottom + lid_h;          // 5.375 — верх корпуса = верх крышки
// Паз ставится под защёлку: от верха корпуса до центра паза.
// Равенство groove_dz = lid_h - lid_tab_c и есть условие «крышка вровень».
groove_dz  = lid_h - lid_tab_c;           // 1.1

case_x   = cav_w + 2 * wall;              // 20.2
case_y   = front_wall + cav_l + wall;     // 27.35
case_z   = case_h;
cx       = case_x / 2;                    // ось симметрии по X
cav_x0   = wall;                          // 1.0
cav_y0   = front_wall;                    // 0.7
cav_y1   = front_wall + cav_l;            // 26.35

groove_z   = case_z - groove_dz;          // центр паза по Z

// Рамка USB-A: накладка поверх язычка, доводящая штекер до usba_total_h
shim_th    = usba_total_h - pcb_th;       // толщина накладки = 0.4
shim_z0    = pcb_top;                     // накладка лежит на плате
// радиус перехода от утолщённого корня к накладке — касательный с обеих сторон
usba_root_r = usba_root_th - shim_th;     // 0.6
usba_slot_hw = usba_w / 2 + usba_slot_gap; // полуширина паза в передней стенке

tongue_y0  = tongue_end - tongue_len;     // заделка язычка = 20.863
tongue_cy  = tongue_end - tongue_len / 2; // центр язычка по Y = 23.448

notch_z0   = edge_r + notch_edge_gap;         // низ насечек = 1.5
notch_z1   = case_z - edge_r - notch_edge_gap; // верх насечек = 3.8
notch_zmid = (notch_z0 + notch_z1) / 2;
notch_ang  = atan(notch_slope);           // угол наклона насечки от вертикали
notch_len  = (notch_z1 - notch_z0) / cos(notch_ang);

// клип тест-фрагментов берёт высоту отсюда
base_L = case_x;
base_W = case_y;
base_h = case_z;

// ===== Вспомогательные функции ====================
function clamp(val, lo, hi) = max(lo, min(val, hi));

// профиль паза под защёлку: пары [доля глубины, доля полувысоты].
// Обе координаты нормированы, чтобы профиль масштабировался вместе с
// groove_d и groove_hh и сохранял замеренную с оригинала форму.
function groove_pts() = [
  [0.000, -1.000], [0.237, -0.667], [0.713, -0.333], [0.951, -0.167],
  [1.000,  0.000],
  [0.951,  0.167], [0.713,  0.333], [0.237,  0.667], [0.000,  1.000]
];

// ===== Модули деталей ====================

// Наружный объём корпуса: все рёбра скруглены одним радиусом
module case_body(){
  rounded_prism(size = [case_x, case_y], h = case_z, r = edge_r, kr = edge_r);
}

// Полость под плату: широкая над полкой, узкая ниша под платой,
// за полкой (Y > shelf_l) полость на всю ширину до дна
module case_cavity(){
  // над полкой — вся ширина полости
  translate([cav_x0, cav_y0, shelf_z])
    cube([cav_w, cav_l, case_z - shelf_z + tiny]);
  // ниша под платой — узкая, на всю длину
  translate([cx - shelf_in_hw, cav_y0, floor_th])
    cube([2 * shelf_in_hw, cav_l, shelf_z - floor_th]);
  // за концом полки — вся ширина до дна
  translate([cav_x0, shelf_l, floor_th])
    cube([cav_w, cav_y1 - shelf_l, shelf_z - floor_th]);
}

// Паз в передней стенке точно под сечение язычка платы.
// В отличие от исходной модели вырез не идёт до верха: стенка над платой
// остаётся сплошной и служит корнем для накладки рамки.
module usb_slot(){
  translate([cx - usba_slot_hw, -tiny, shelf_z - usb_slot_dh])
    cube([2 * usba_slot_hw, cav_y0 + 2 * tiny, pcb_th + usb_slot_dh]);
}

// Рамка USB-A: накладка поверх выступающего язычка платы.
// Лежит на плате, продолжая переднюю стенку вперёд; вместе с платой даёт
// штекер usba_total_h толщиной. Контакты платы снизу и остаются открытыми.
module usba_frame(){
  difference(){
    translate([cx - usba_w / 2, -usba_len, shim_z0])
      cube([usba_w, usba_len + tiny, shim_th]);
    // заходная фаска по верхней передней кромке (диагональный клин)
    translate([cx, -usba_len, shim_z0 + shim_th])
      rotate([45, 0, 0])
        cube([usba_w + 2 * tiny, usba_ch * sqrt(2), usba_ch * sqrt(2)], center = true);
  }
}

// Усиление корня накладки: вогнутая галтель между верхом накладки и передней
// стенкой. Накладка — консоль 0.4 мм вылетом 12 мм, весь изгибающий момент
// приходится на заделку, и прямой внутренний угол работает концентратором
// напряжений (при печати это ещё и граница слоёв). Галтель радиусом r доводит
// сечение в корне до shim_th + r и убирает угол.
// Профиль строится в плоскости Y-Z и вытягивается по X на ширину накладки:
// rotate([90,0,90]) отображает 2D u -> Y, v -> Z, а направление выдавливания в +X.
// Утолщённый корень накладки: брусок полной толщины usba_root_th от стенки
// на usba_root_len вперёд, дальше вогнутый переход радиусом usba_root_r
// к номинальной толщине накладки. Переход касательный с обеих сторон, поэтому
// концентратора напряжений в стыке нет.
// Профиль строится в плоскости Y-Z и вытягивается по X на ширину накладки:
// rotate([90,0,90]) отображает 2D u -> Y, v -> Z, а направление выдавливания в +X.
module usba_root_boss(){
  th = usba_root_th;
  r  = usba_root_r;
  y1 = -usba_root_len;
  if (th > shim_th)
    translate([cx - usba_w / 2, 0, shim_z0])
      rotate([90, 0, 90])
        linear_extrude(height = usba_w)
          union(){
            translate([y1, 0]) square([usba_root_dy - y1, th]);
            difference(){
              translate([y1 - r, 0]) square([r, th]);
              translate([y1 - r, shim_th + r]) circle(r = r, $fs = pin_fs);
            }
          }
}

// Брусок-паз: режет в -X от плоскости x=0, тянется по Y от 0 до len
module groove_bar(len, depth){
  pts = groove_pts();
  profile = concat(
    [for (p = pts) [-depth * p[0], groove_hh * p[1]]],
    [[tiny, groove_hh], [tiny, -groove_hh]]
  );
  translate([0, len, 0]) rotate([90, 0, 0])
    linear_extrude(height = len) polygon(points = profile);
}

// Пазы под защёлки крышки: по два на каждой боковой стенке + один в задней
module lid_grooves(){
  for (g = [groove_y1, groove_y2]){
    // левая стенка: режем наружу от внутренней грани x=cav_x0
    translate([cav_x0, g[0], groove_z]) groove_bar(g[1] - g[0], groove_d);
    // правая стенка — зеркально
    translate([case_x, 0, 0]) mirror([1, 0, 0])
      translate([cav_x0, g[0], groove_z]) groove_bar(g[1] - g[0], groove_d);
  }
  // задняя стенка: тот же профиль, развёрнут на 90° (режет в +Y)
  translate([cx - groove_back_hw, cav_y1, groove_z]) rotate([0, 0, -90])
    groove_bar(2 * groove_back_hw, groove_d);
}

// Одна диагональная насечка: врезается в +X от плоскости стенки x=0
module side_notch(){
  profile = [
    [-tiny, -notch_open_w / 2], [0, -notch_open_w / 2],
    [notch_depth, -notch_bot_w / 2], [notch_depth, notch_bot_w / 2],
    [0, notch_open_w / 2], [-tiny, notch_open_w / 2]
  ];
  rotate([notch_ang, 0, 0])
    linear_extrude(height = notch_len, center = true) polygon(points = profile);
}

// Насечки на обеих боковых стенках
module side_notches(){
  for (i = [0 : notch_n - 1]){
    yc = notch_y0 + i * notch_pitch;
    translate([0, yc, notch_zmid]) side_notch();
    translate([case_x, 0, 0]) mirror([1, 0, 0])
      translate([0, yc, notch_zmid]) side_notch();
  }
}

// П-образная прорезь вокруг одного язычка-кнопки (2D).
// Начало координат — на оси язычка у его свободного конца; язычок уходит в -Y.
// Прорезь прямоугольная: поперечина за концом язычка и две ножки вдоль него.
// Ножки продлены до конца поперечины, чтобы углы были замкнуты и между язычком
// и дном не осталось перемычки.
module button_slot_2d(){
  hw_out = tongue_hw + slot_w;
  union(){
    translate([-hw_out, 0]) square([2 * hw_out, slot_w]);
    translate([-hw_out, -tongue_len]) square([slot_w, tongue_len]);
    translate([tongue_hw, -tongue_len]) square([slot_w, tongue_len]);
  }
}

// Прорези обеих кнопок насквозь через дно
module button_slots(){
  for (s = [-1, 1])
    translate([cx + s * tongue_cx, tongue_end, -tiny])
      linear_extrude(height = floor_th + 2 * tiny) button_slot_2d();
}

// Отверстие в дне под деталь платы (в оригинале — глухой карман глубиной 1.2
// с остатком 0.8; при дне 0.8 мм становится сквозным)
module floor_hole(){
  translate([cx + hole_cx, hole_cy, -tiny])
    cylinder(h = floor_th + 2 * tiny, d = hole_d, $fs = pin_fs);
}

// Гравировка B и R на дне (читается снизу).
// label_flip = true — буквы развёрнуты на 180° (взгляд на девайс с другой стороны):
// «верх» буквы смотрит в -Y. Каждая буква остаётся на своём язычке-кнопке.
module bottom_labels(){
  if (labels_on) for (i = [0, 1]){
    s = (i == 0) ? -1 : 1;
    off = (i == 0) ? label_b_off : label_r_off;
    translate([cx + s * tongue_cx + off[0], tongue_cy + off[1], -tiny])
      linear_extrude(height = label_depth + tiny)
        rotate([0, 0, label_flip ? 180 : 0])
          mirror([1, 0, 0])
            text(text = (i == 0) ? "B" : "R", size = label_size, font = label_font,
                 halign = "center", valign = "center");
  }
}

// Корпус целиком
module case_part(){
  difference(){
    union(){
      case_body();
      usba_frame();
      usba_root_boss();
    }
    side_notches();
    case_cavity();
    usb_slot();
    lid_grooves();
    button_slots();
    floor_hole();
    bottom_labels();
  }
}

// --- Крышка: локальный центр в центре пластины, низ бортика в z=0 ---

// Контур пластины (передний язычок — при lid_ftab_len > 0)
module lid_plate_2d(){
  square([lid_w, lid_l], center = true);
  if (lid_ftab_len > 0)
    translate([0, -(lid_l / 2 + lid_ftab_len / 2)])
      square([2 * lid_ftab_hw, lid_ftab_len], center = true);
}

// Пластина крышки
module lid_plate(){
  translate([0, 0, lid_rim_h])
    linear_extrude(height = lid_plate_th) lid_plate_2d();
}

// Передний язычок на всю высоту крышки (заходит в вырез USB)
module lid_front_tab(){
  if (lid_ftab_len > 0)
    translate([-lid_ftab_hw, -(lid_l / 2 + lid_ftab_len), 0])
      cube([2 * lid_ftab_hw, lid_ftab_len, lid_rim_h]);
}

// Бортик: рамка с заходной фаской по внутреннему контуру
module lid_rim(){
  difference(){
    linear_extrude(height = lid_rim_h) square([lid_w, lid_l], center = true);
    hull(){
      translate([0, 0, -tiny])
        linear_extrude(height = tiny)
          offset(r = lid_rim_r) offset(r = -lid_rim_r)
            square([lid_rim_bot_x, lid_rim_bot_y], center = true);
      translate([0, 0, lid_rim_h])
        linear_extrude(height = tiny)
          offset(r = lid_rim_r) offset(r = -lid_rim_r)
            square([lid_rim_top_x, lid_rim_top_y], center = true);
    }
  }
}

// Боковые защёлки крышки: скруглённый гребень по краю пластины
module lid_side_tabs(){
  th = lid_tab_h;
  for (sy = [-1, 1]) for (sx = [-1, 1]){
    translate([sx * lid_w / 2, sy * lid_tab_cy, lid_tab_c])
      rotate([-90, 0, 0])
        linear_extrude(height = lid_tab_len, center = true)
          polygon(points = [
            [0, -th / 2], [sx * lid_tab_out, -th / 4],
            [sx * lid_tab_out, th / 4], [0, th / 2]
          ]);
  }
}

// Задняя защёлка: тот же принцип, что у боковых, и на той же высоте lid_tab_c.
// Раньше она была продолжением пластины, то есть сидела у верха крышки. После
// переноса пазов вниз она перестала попадать в задний паз и упиралась в глухую
// стенку — крышка вставала на ней выше корпуса примерно на 0.8 мм.
// Профиль тот же, что у боковых: у корня полная толщина lid_rtab_th, к вершине
// сужается вдвое — заходные фаски сверху и снизу. Прямоугольный язычок вставал
// в линзовидный паз враспор (натяг 0.29 мм), с фасками натяг падает до 0.13 —
// это уже посадка защёлкой, а не заклинивание.
module lid_rear_tab(){
  th = lid_rtab_th;
  translate([-lid_rtab_hw, lid_l / 2, lid_tab_c])
    rotate([90, 0, 90])
      linear_extrude(height = 2 * lid_rtab_hw)
        polygon(points = [
          [-tiny, -th / 2], [lid_rtab_len, -th / 4],
          [lid_rtab_len, th / 4], [-tiny, th / 2]
        ]);
}

// Крышка целиком
module lid_part(){
  lid_rim();
  lid_front_tab();
  lid_plate();
  lid_side_tabs();
  lid_rear_tab();
}

// Крышка в печатной ориентации.
// В сборке бортик смотрит вниз, и при печати в этой позе пластина оказывается
// мостом над проёмом бортика (~14 x 21.5 мм) — нужны поддержки. Перевёрнутая
// крышка лежит пластиной на столе, а проём бортика расширяется кверху, то есть
// каждый слой опирается на предыдущий. Поворот вокруг Y, а не X: деталь
// симметрична по X, поэтому перёд/зад остаются на своих местах.
module lid_placed(){
  if (lid_flip) translate([0, 0, lid_h]) rotate([0, 180, 0]) lid_part();
  else lid_part();
}

// ===== Вывод всех фрагментов ====================
module all_parts(){
  // рамка выступает в -Y, поэтому корпус сдвинут вперёд: модель начинается с y=0
  if (print_case) translate([0, usba_len, 0]) case_part();
  if (print_lid)
    translate([case_x + part_gap_x + lid_w / 2 + lid_tab_out,
               usba_len + case_y / 2, 0])
      lid_placed();
}

module main(){
  clip_for_fragments(){ all_parts(); }
}

// ===== Точка входа ====================
main();
